{
  "name": "@langri-sha/eslint-config",
  "version": "0.9.19",
  "description": "Shared ESLint flat config",
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "typescript"
  ],
  "homepage": "https://github.com/langri-sha/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/langri-sha/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langri-sha/eslint-config.git"
  },
  "license": "MIT",
  "author": {
    "name": "Filip Dupanović",
    "email": "filip.dupanovic@gmail.com",
    "url": "https://langri-sha.com",
    "organization": false
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "change": "pnpm exec projen change",
    "default": "pnpm exec projen default",
    "prepare": "husky",
    "prepublishOnly": "rm -rf dist; tsc --project tsconfig.build.json",
    "renovate": "pnpm exec projen renovate"
  },
  "dependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.2.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.1"
  },
  "devDependencies": {
    "@langri-sha/lint-staged": "0.9.10",
    "@langri-sha/prettier": "0.4.11",
    "@langri-sha/projen-project": "0.35.0",
    "@langri-sha/tsconfig": "1.1.1",
    "beachball": "2.66.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "projen": "0.86.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "packageManager": "pnpm@12.10.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">= 24.16.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
